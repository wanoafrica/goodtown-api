{
  "name": "goodtown-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Goodtown REST API — Hono on Node, MongoDB Atlas, Better Auth",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/server.js",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "load:kansas": "tsx scripts/load-kansas.ts",
    "email:preview": "tsx scripts/preview-email.ts",
    "format": "prettier -w src scripts test",
    "seed:feed": "tsx scripts/seed-feed.ts"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "^1.7.7",
    "@hono/node-server": "^1.19.9",
    "@scalar/hono-api-reference": "^0.12.9",
    "better-auth": "^1.7.7",
    "hono": "^4.13.13",
    "hono-openapi": "^1.3.3",
    "mongodb": "^7.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@turf/area": "^7.4.0",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/point-on-feature": "^7.4.0",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.20.5",
    "@types/shapefile": "^0.6.4",
    "adm-zip": "^0.6.1",
    "esbuild": "^0.27.0",
    "mongodb-memory-server": "^11.3.0",
    "polygon-clipping": "^0.15.7",
    "prettier": "^3.9.9",
    "shapefile": "^0.6.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
