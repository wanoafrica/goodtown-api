# Copy to .dev.vars (git-ignored). Never commit real values.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/goodtown?retryWrites=true&w=majority
BETTER_AUTH_SECRET=change-me-32-bytes-random
BETTER_AUTH_URL=http://localhost:8787
SENDGRID_API_KEY=SG.xxxxx
# Set to 1 to print OTP codes to the wrangler console instead of emailing them.
OTP_DEBUG_LOG=1

# Serve /docs and /openapi.json locally (production leaves this off)
DOCS_ENABLED=1
