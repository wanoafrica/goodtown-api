# Copy to .env for local development (git-ignored). Production: set these as environment variables / secrets on the host.

# --- required ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL of this API (what the apps call)
BETTER_AUTH_URL=http://localhost:8080

# --- email ---
SENDGRID_API_KEY=
EMAIL_FROM=hello@goodtown.app
# SUPPORT_EMAIL=hello@goodtown.app

# --- config (defaults shown) ---
APP_NAME=Goodtown
TERMS_VERSION=2026-10
LAUNCH_STATE=KS
PORT=8080
# Header(s) carrying the client IP (rate limiting). Only trusted with TRUST_PROXY=1 (a reverse proxy sets
# them); otherwise they are overwritten with the socket address so clients cannot spoof them.
TRUSTED_IP_HEADERS=x-forwarded-for
# TRUST_PROXY=1

# --- local dev only ---
# Log OTP codes to the console instead of sending email (rejected when NODE_ENV=production;
# without it SENDGRID_API_KEY is required)
OTP_DEBUG_LOG=1
# Serve /docs and /openapi.json
DOCS_ENABLED=1
