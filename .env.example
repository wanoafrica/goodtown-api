# Copy to .env for local development (git-ignored). Production: set these as environment variables / secrets on the host.

# --- required ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL of this API (what the apps call)
BETTER_AUTH_URL=http://localhost:8080

# --- email ---
SENDGRID_API_KEY=
EMAIL_FROM=hello@goodtown.app
# SUPPORT_EMAIL=hello@goodtown.app

# --- config (defaults shown) ---
APP_NAME=Goodtown
TERMS_VERSION=2026-10
LAUNCH_STATE=KS
PORT=8080
# Header(s) carrying the client IP behind the reverse proxy (rate limiting)
TRUSTED_IP_HEADERS=x-forwarded-for

# --- local dev only ---
# Log OTP codes to the console instead of sending email
OTP_DEBUG_LOG=1
# Serve /docs and /openapi.json
DOCS_ENABLED=1
